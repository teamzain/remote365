{
    email {$CADDY_EMAIL:admin@remote365.ai}
}

(cors) {
    header {
        Access-Control-Allow-Origin "http://127.0.0.1:5173"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, Origin, Accept"
        Access-Control-Allow-Credentials "true"
    }
}

{$CADDY_SITE:remote365.ai, www.remote365.ai, :80} {
    # Universal API handling
    handle /api/* {
        # Auth & Admin Services
        handle /api/auth* {
            reverse_proxy auth-service:3001
        }
        
        handle /api/devices* {
            reverse_proxy auth-service:3001
        }

        handle /api/members* {
            reverse_proxy auth-service:3001
        }

        handle /api/groups* {
            reverse_proxy auth-service:3001
        }

        handle /api/organizations* {
            reverse_proxy auth-service:3001
        }

        handle /api/support* {
            reverse_proxy auth-service:3001
        }

        handle /api/chat* {
            reverse_proxy auth-service:3001
        }

        handle /api/analytics* {
            reverse_proxy auth-service:3001
        }

        handle /api/admin* {
            reverse_proxy auth-service:3001
        }

        # Signaling Service (WebSocket)
        handle /api/signal* {
            reverse_proxy signaling-service:3002
        }

        # Session Service
        handle /api/sessions* {
            reverse_proxy session-service:3003
        }

        handle /api/session* {
            reverse_proxy session-service:3003
        }

        # Billing API
        handle /api/billing* {
            uri strip_prefix /api
            reverse_proxy billing-service:3004
        }
    }

    # Desktop App Downloads & Updates
    handle /downloads/* {
        root * /var/www
        file_server browse
    }

    # Onboarding Page (Served by Auth Service)
    handle /onboard* {
        reverse_proxy auth-service:3001
    }

    # Legacy billing service (proxied to billing-service)
    handle /billing* {
        reverse_proxy billing-service:3004
    }

    # Web app (SPA): everything not matched above (site root, /meeting/CODE,
    # /login, /dashboard …) serves the built apps/web bundle. Unknown paths
    # fall back to index.html so client-side routes survive direct loads.
    handle {
        root * /var/www/webapp
        # Hashed bundles never change; the HTML that points at them must be
        # re-checked every load, or browsers keep an old bundle after a deploy.
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @page not path /assets/*
        header @page Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
