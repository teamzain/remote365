{
    email {$CADDY_EMAIL:admin@remote365.ai}
}

(cors) {
    header {
        Access-Control-Allow-Origin "http://127.0.0.1:5173"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, Origin, Accept"
        Access-Control-Allow-Credentials "true"
    }
}

{$CADDY_SITE:remote365.ai, www.remote365.ai, :80} {
    # One canonical host for search engines: www -> apex. (Preprod's
    # CADDY_SITE has no www, so this never fires there.)
    @www host www.remote365.ai
    redir @www https://remote365.ai{uri} 301

    # Preprod mirrors prod; keep it out of search results.
    @preprod host pp.remote365.ai
    header @preprod X-Robots-Tag "noindex, nofollow"

    # Universal API handling
    handle /api/* {
        # Auth & Admin Services
        handle /api/auth* {
            reverse_proxy auth-service:3001
        }
        
        handle /api/devices* {
            reverse_proxy auth-service:3001
        }

        handle /api/members* {
            reverse_proxy auth-service:3001
        }

        handle /api/groups* {
            reverse_proxy auth-service:3001
        }

        handle /api/organizations* {
            reverse_proxy auth-service:3001
        }

        handle /api/support* {
            reverse_proxy auth-service:3001
        }

        handle /api/chat* {
            reverse_proxy auth-service:3001
        }

        handle /api/analytics* {
            reverse_proxy auth-service:3001
        }

        handle /api/admin* {
            reverse_proxy auth-service:3001
        }

        # Signaling Service (WebSocket)
        handle /api/signal* {
            reverse_proxy signaling-service:3002
        }

        # Session Service
        handle /api/sessions* {
            reverse_proxy session-service:3003
        }

        handle /api/session* {
            reverse_proxy session-service:3003
        }

        # Google Play billing (/verify and the Pub/Sub /rtdn push) is served by
        # auth-service's routes/billing.ts, not billing-service. Caddy tries the
        # longest path first, so this wins over /api/billing* below.
        handle /api/billing/google-play* {
            reverse_proxy auth-service:3001
        }

        # Billing API
        handle /api/billing* {
            uri strip_prefix /api
            reverse_proxy billing-service:3004
        }
    }

    # Desktop App Downloads & Updates
    handle /downloads/* {
        root * /var/www
        file_server browse
    }

    # Onboarding Page (Served by Auth Service)
    handle /onboard* {
        reverse_proxy auth-service:3001
    }

    # Legacy billing service (proxied to billing-service)
    handle /billing* {
        reverse_proxy billing-service:3004
    }

    # Website + web app (Next.js, the `web` service): everything not matched
    # above — site pages, /login, /dashboard, /meeting/CODE … Next sets the
    # cache headers itself (hashed /_next/static files are immutable).
    handle {
        encode zstd gzip
        reverse_proxy web:3000
    }
}
