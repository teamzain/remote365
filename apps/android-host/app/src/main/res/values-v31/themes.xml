<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ shows a system splash (the app icon on a solid background) every time a task is
  launched or brought forward — so bouncing out to Settings and back during onboarding flashed the
  logo between every step. We draw our own branded splash in Compose, so the system one is pure
  noise: make its icon transparent and its background white, leaving an imperceptible white frame.
-->
<resources>
    <style name="Theme.Remote365Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="Theme.Remote365Host" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
