{
  "cli": {
    "version": ">= 16.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pp.remote365.ai"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "ios-preprod": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pp.remote365.ai"
      },
      "ios": {
        "simulator": false
      }
    },
    "ios-production": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://remote365.ai"
      },
      "ios": {
        "simulator": false
      }
    },
    "ios-screenshots": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "ios-preprod": {
      "ios": {
        "ascAppId": "6807023936",
        "ascApiKeyPath": "./credentials/ios/AuthKey_AN4Z39TU7U.p8",
        "ascApiKeyId": "AN4Z39TU7U",
        "ascApiKeyIssuerId": "5814c691-0fc0-4848-9f39-38ad4f3eb843"
      }
    },
    "ios-production": {
      "ios": {
        "ascAppId": "6836702539",
        "ascApiKeyPath": "./credentials/ios/AuthKey_NF6MLBQ67T.p8",
        "ascApiKeyId": "NF6MLBQ67T",
        "ascApiKeyIssuerId": "02279965-0ca0-4403-9ed0-65c2bbaa05be"
      }
    }
  }
}
