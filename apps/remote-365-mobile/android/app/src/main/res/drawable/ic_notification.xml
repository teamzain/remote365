<!--
  Small icon for the MediaProjection foreground-service notification.

  react-native-webrtc resolves this by NAME at runtime:
      MediaProjectionNotification.java:64-65
      context.getResources().getIdentifier("ic_notification", "drawable", packageName)
  A missing drawable resolves to 0, and setSmallIcon(0) makes startForeground() throw
  "Bad notification for startForeground: invalid small icon" — so this file is required
  the moment enableMediaProjectionService is turned on in MainApplication.kt.

  Android renders notification small icons as an alpha mask: only the alpha channel is
  used and the system tints it, so this is deliberately solid white on transparent with
  no colour detail. A vector covers every density, so no per-dpi PNG set is needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Monitor body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,3H4C2.9,3 2,3.9 2,5v11c0,1.1 0.9,2 2,2h5l-1,2v1h8v-1l-1,-2h5c1.1,0 2,-0.9 2,-2V5C22,3.9 21.1,3 20,3zM20,16H4V5h16V16z" />
    <!-- Share arrow, marking this as a screen-share session rather than a plain window -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7l-3.5,3.5h2.25v3h2.5v-3h2.25L12,7z" />
</vector>
