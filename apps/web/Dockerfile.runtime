# Runtime image for the Next.js web app (the `web` service).
#
# The app is built in CI by scripts/build-web-release.sh, which assembles
# web-release/ (this file + the standalone server). Building the image only
# copies files, so the 4 GB droplet never runs npm install or next build.
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_OPTIONS=--max-old-space-size=384

# /pricing reads the plan catalogue on the server, straight from
# billing-service on the Compose network (the same route Caddy serves as
# /api/billing/plans). Unreachable = the built-in catalogue is shown.
ENV PLANS_API_URL=http://billing-service:3004/billing/plans

WORKDIR /app
COPY app/ /app/
# The server writes regenerated pages and its image/fetch cache under .next;
# everything else stays read-only to the app user.
RUN chown -R node:node /app/apps/web/.next
USER node

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
