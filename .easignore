# Allow only the mobile viewer and its monorepo build prerequisites.
# EAS uses this instead of .gitignore, so keep secrets explicitly excluded.
/*
!/.easignore
!/package.json
!/package-lock.json
!/apps
/apps/*
!/apps/remote-365-mobile
/apps/remote-365-mobile/*
!/apps/remote-365-mobile/app.json
!/apps/remote-365-mobile/App.tsx
!/apps/remote-365-mobile/eas.json
!/apps/remote-365-mobile/index.js
!/apps/remote-365-mobile/metro.config.js
!/apps/remote-365-mobile/package.json
!/apps/remote-365-mobile/react-native.config.js
!/apps/remote-365-mobile/tsconfig.json
!/apps/remote-365-mobile/assets
!/apps/remote-365-mobile/assets/**
# Config plugins run during the cloud prebuild, so their sources (including the iOS
# broadcast-extension Swift files) must be uploaded or the build fails at prebuild.
!/apps/remote-365-mobile/plugins
!/apps/remote-365-mobile/plugins/**
!/apps/remote-365-mobile/src
!/apps/remote-365-mobile/src/**
!/apps/remote-365-mobile/android
!/apps/remote-365-mobile/android/**
!/apps/remote-365-mobile/ios
!/apps/remote-365-mobile/ios/**
!/scripts
/scripts/*
!/scripts/patch-react-native-webrtc-default-display.mjs

**/node_modules/
**/.git/
**/.expo/
**/.gradle/
**/.cxx/
**/build/
**/Pods/
**/.env
**/.env.*
**/.npmrc
**/credentials.json
**/local.properties
**/key.properties
**/keystore.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.mobileprovision
**/*.apk
**/*.aab
**/*.ipa
**/*.log
