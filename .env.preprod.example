# --- Pre-Production Environment Template ---
# Copy this to the pre-prod server as $HOME/.env.preprod and fill secrets.

DB_USER=remotelink
DB_PASSWORD=your_secure_password
DB_NAME=remotelink
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

REDIS_URL=redis://redis:6379

JWT_SECRET=generate_a_preprod_only_secret

STRIPE_SECRET_KEY=sk_test_...
EMAIL=your-email@example.com
DOMAIN=pp.remote365.ai
CADDY_EMAIL=admin@remote365.ai
CADDY_SITE=pp.remote365.ai, :80
DESKTOP_DOWNLOAD_URL=https://pp.remote365.ai/downloads/desktop/
GOOGLE_CALLBACK_URL=https://pp.remote365.ai/api/auth/oauth/google/callback
# Sign-in return URLs: this site's own origins, plus loopback (localhost on any
# port, for local web development) unless OAUTH_ALLOW_LOCAL_RETURN_URLS=false.
# See .env.production.example.

TURN_USER=admin
TURN_PASSWORD=generate_a_preprod_only_turn_password
TURN_REALM=pp.remote365.ai
TURN_HOST=pp.remote365.ai
SERVER_IP=206.189.127.215
# Optional: time-limited TURN credentials (TURN REST API). When set, auth-service
# and signaling-service mint "expiry:identity" + HMAC-SHA1 credentials instead of
# handing out TURN_USER/TURN_PASSWORD. coturn must then run with
#   --use-auth-secret --static-auth-secret=<same value>
# (docker-compose.prod.yml currently starts coturn with --user only, so leave this
# unset until that command is changed, or every relay allocation will fail).
# TURN_REST_SECRET=
# TURN_TTL_SECONDS=3600


# Allow paid-plan switches without payment (QA only - keep off in production)
BILLING_TEST_MODE=true

# --- Google Play Billing (Android subscriptions) ---
# The whole service-account key file from Google Cloud, as one line of JSON. Created
# against the Cloud project linked to Play, then granted "View financial data" in Play
# Console > Users and permissions. Permission propagation can take up to 24h.
# Unset = the verify endpoint answers 503 and purchases are auto-refunded rather than
# silently granted.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Must match the package name of the AAB uploaded to Play.
GOOGLE_PLAY_PACKAGE_NAME=com.remote365.mobile
# Real-time Developer Notifications (Pub/Sub push) authenticity. Set ONE of these, or the
# endpoint refuses every push rather than trusting the internet.
#   Simple: a shared secret appended to the push URL as ?secret=...
#   Preferred: the OIDC audience configured on the Pub/Sub subscription's push auth.
GOOGLE_PLAY_RTDN_SECRET=
GOOGLE_PLAY_RTDN_AUDIENCE=

# Microsoft sign-in (Entra ID app registration: Web platform, redirect URI = MICROSOFT_CALLBACK_URL)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=https://pp.remote365.ai/api/auth/oauth/microsoft/callback
